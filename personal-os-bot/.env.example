# Токен от @BotFather
BOT_TOKEN=123456789:AA...your-token...

# Ваш Telegram ID (число). Не знаете? Оставьте пустым, запустите бота и напишите ему —
# он ответит вашим ID. Бот работает ТОЛЬКО для этого ID.
OWNER_ID=

# Необязательно (значения по умолчанию):
# DB_PATH=data/personal_os.db
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14
# LOG_DIR=logs
# DEFAULT_TIMEZONE=Asia/Dubai

# ---- Бесплатный AI (необязательно) -------------------------------------
# Без него бот работает на правилах. С ним — понимает сложные фразы,
# пересланные SMS банка, списки и фото чеков. Подробности в README.
#
# Вариант 1 (рекомендую): Google Gemini, ключ бесплатно на https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# AI_API_KEY=...
#
# Вариант 2: Groq, ключ на https://console.groq.com/keys
# AI_PROVIDER=groq
# AI_API_KEY=...
#
# Вариант 3: полностью локально, данные не покидают Mac (https://ollama.com)
# AI_PROVIDER=ollama
#
# Можно переопределить модель/адрес:
# AI_MODEL=
# AI_VISION_MODEL=
# AI_BASE_URL=
