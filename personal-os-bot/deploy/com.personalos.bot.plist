<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: автозапуск при входе в систему и перезапуск при падении.
     Замените /Users/YOU/personal-os-bot на реальный путь. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.personalos.bot</string>
    <key>ProgramArguments</key>
    <array><string>/Users/YOU/personal-os-bot/scripts/run.sh</string></array>
    <key>WorkingDirectory</key><string>/Users/YOU/personal-os-bot</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>/Users/YOU/personal-os-bot/logs/launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Users/YOU/personal-os-bot/logs/launchd.err.log</string>
</dict>
</plist>
